resources/arabic-ocr/ppocrv5_arabic_dict.txt
resources/arabic-ocr/checksums.sha256
resources/arabic-ocr/.nassila-arabic-ocr-ready

# TypeScript incremental build cache (machine-specific)
*.tsbuildinfo

# Private manuscript PDFs (acceptance-set only; never commit / never train)
docs/pdf/

# Generated codebase dump (Repomix) — regenerate locally, keep out of git
codebase.txt

# Indra OCR (fetched on first run; weights are OpenRAIL-M and never committed)
resources/indra-ocr/models/
resources/indra-ocr/venv/
resources/indra-ocr/checksums.sha256
resources/indra-ocr/.nassila-indra-ocr-ready
