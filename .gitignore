# Cursor skill installer cache (large zips / extracted trees)
.cursor/.skills-vendor/

# Local multi-root workspace (paths are machine-specific)
Nassila-Ouroboros.code-workspace

# Local OCR downloads & file dumps
*.traineddata

# pdf-inspector offline models / shared libs (operator-fetched; see resources/pdf-inspector/README.md)
resources/pdf-inspector/pp-ocrv6-small/
resources/pdf-inspector/runtime/
resources/pdf-inspector/checksums.sha256

# Arabic PP-OCRv5 ONNX pack (operator-fetched; see resources/arabic-ocr/README.md)
